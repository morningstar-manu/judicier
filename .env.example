# Turso (LibSQL) — requis pour la persistance partagée en production
TURSO_DATABASE_URL=libsql://votre-base-nom-utilisateur.turso.io
TURSO_AUTH_TOKEN=votre_token_turso

# Secret JWT API (sinon fallback TURSO_AUTH_TOKEN)
GESTIPERS_API_SECRET=

# Aria Identité (ONCA) — optionnel
ARIA_IDENTITE_URL=
ARIA_IDENTITE_API_KEY=
ARIA_REQUESTER_ID=gestipers
ARIA_LEGAL_BASIS=

# Développement local : forcer IndexedDB au lieu de l'API Turso
# VITE_STORAGE=local

# URL publique de l'app (QR codes — build-time via Vite / Docker ARG)
VITE_APP_URL=https://gestipers.datapr.org

# Serveur Node (Proxmox / Docker)
PORT=3000
HOST=0.0.0.0

# Plane.so — bootstrap projet migration (scripts/plane-bootstrap.mjs)
# PLANE_API_KEY=
# PLANE_WORKSPACE_SLUG=
# PLANE_API_BASE=https://api.plane.so
